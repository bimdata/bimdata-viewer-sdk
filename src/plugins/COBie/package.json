{
  "name": "@bimdata/cobie-viewer-plugin",
  "type": "module",
  "version": "0.0.3",
  "description": "COBie BIMData Viewer Plugin",
  "scripts": {
    "build": "vite build && terser -c -m -o dist/cobie.plugin.js --module dist/cobie.plugin.js",
    "watch": "vite build --watch",
    "prepublishOnly": "npm run build"
  },
  "main": "./dist/cobie.plugin.js",
  "module": "./dist/cobie.plugin.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "BIMData",
    "Viewer",
    "Plugin",
    "open BIM",
    "COBie"
  ],
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "exceljs": "^4.4.0",
    "rollup-plugin-external-globals": "^0.7.1",
    "sass": "^1.53.0",
    "terser": "^5.17.1",
    "vite": "^4.3.1",
    "vite-plugin-css-injected-by-js": "^2.4.0"
  }
}
